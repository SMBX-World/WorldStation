server:
  forward-headers-strategy: native

spring:
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
  datasource:
    url: ${SPRING_DATASOURCE_URL}
    username: ${SPRING_DATASOURCE_USERNAME}
    password: ${SPRING_DATASOURCE_PASSWORD}
    driver-class-name: org.postgresql.Driver

springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    enabled: ${SWAGGER_UI_ENABLED}
    path: /docs
    csrf:
      enabled: true
      cookie-name: "XSRF-TOKEN"

logging:
  level:
    org.springframework.security: DEBUG
    org.springframework.web: DEBUG
    org.springframework.boot.autoconfigure.security.servlet: DEBUG
    org.springframework.boot.actuate.endpoint.web: DEBUG


worldstation:
  flarum:
    base-url: ${FLARUM_BASE_URL}
    connect-timeout: 5s
    read-timeout: 10s
  auth:
    jwt-secret: ${AUTH_JWT_SECRET}
    session-ttl: 90d
    cookie-name: ${AUTH_COOKIE_NAME}
    cookie-secure: ${AUTH_COOKIE_SECURE}
    cookie-same-site: ${AUTH_COOKIE_SAME_SITE}
    max-login-failures: 10
    failure-window: 10m
  admin:
    ids: [1, 3, 6]
  upload:
    temp-dir: ./upload-tmp
    chunk-size: 8388608
    stream-start-window-chunks: 4
    chunk-wait-timeout-seconds: 60
    session-ttl-hours: 2
    max-active-sessions-per-user: 2
    keep-chunks-until-completed: true
  storage:
    s3:
      endpoint: ${S3_ENDPOINT}
      region: ${S3_REGION}
      bucket: ${S3_BUCKET}
      public-base-url: ${S3_PUBLIC_BASE_URL}
      path-style-access: ${S3_PATH_STYLE_ACCESS}
      access-key: ${S3_ACCESS_KEY}
      secret-key: ${S3_SECRET_KEY}
      session-token: ${S3_SESSION_TOKEN}
      worldmap-prefix: ${S3_WORLDMAP_PREFIX}
      picbed-prefix: ${S3_PICBED_PREFIX}
